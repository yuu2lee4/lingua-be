							"raw": "{\n  \"task_type\": 1,\n  \"model\": \"gemini-2.5-flash\",\n  \"user_group\": \"product\",\n  \"translation_params\": {\n    \"target_languages\": [\"zh-CN\", \"ko-KR\", \"ja-JP\"],\n    \"content\": \"Example is a premier global digital asset trading platform.\"\n  }\n}"
