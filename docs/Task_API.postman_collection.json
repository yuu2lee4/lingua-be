		{
			"name": "查询任务",
			"item": [
				{
					"name": "获取任务状态",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.test('返回 task_id', function () {",
									"        pm.expect(jsonData.task_id).to.be.a('string').and.not.empty;",
									"    });",
									"    pm.test('返回 task_type', function () {",
									"        pm.expect(jsonData.task_type).to.be.oneOf([1, 2]);",
									"    });",
									"    pm.test('返回有效 status', function () {",
									"        pm.expect(jsonData.status).to.be.oneOf([0, 1, 2, 3, 4, 5]);",
									"    });",
									"    pm.test('返回 model', function () {",
									"        pm.expect(jsonData.model).to.be.a('string').and.not.empty;",
									"    });",
									"    pm.test('返回 created_at', function () {",
									"        pm.expect(jsonData.created_at).to.be.a('string').and.not.empty;",
									"    });",
									"    // 完成的翻译任务应有 translation_output",
									"    if (jsonData.status === 4 && jsonData.task_type === 1) {",
									"        pm.test('翻译完成: 返回 translation_output', function () {",
									"            pm.expect(jsonData.translation_output).to.be.an('object');",
									"            pm.expect(jsonData.translation_output.translations).to.be.an('object');",
									"        });",
									"    }",
									"    // 完成的摘要任务应有 summarization_output",
									"    if (jsonData.status === 4 && jsonData.task_type === 2) {",
									"        pm.test('摘要完成: 返回 summarization_output', function () {",
									"            pm.expect(jsonData.summarization_output).to.be.an('object');",
									"            pm.expect(jsonData.summarization_output.summary).to.be.a('string');",
									"        });",
									"    }",
									"    // 失败的任务应有 error_message",
									"    if (jsonData.status === 5) {",
									"        pm.test('失败: 返回 error_message', function () {",
									"            pm.expect(jsonData.error_message).to.be.a('string').and.not.empty;",
									"        });",
									"    }",
									"} else if (pm.response.code === 404) {",
									"    pm.test('任务不存在返回 404', function () {",
									"        pm.expect(pm.response.code).to.eql(404);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ai-api/v1/task/{{task_id}}",
							"host": ["{{base_url}}"],
							"path": ["ai-api", "v1", "task", "{{task_id}}"]
						},
						"description": "根据 task_id 获取任务详情。\n\n使用集合变量 {{task_id}}，由创建任务接口自动设置。\n\n状态枚举：\n- 0: INIT\n- 1: BEFORE_PROCESS\n- 2: PROCESSING\n- 3: AFTER_PROCESS\n- 4: FINISH\n- 5: ERROR"
					},
					"response": []
				},
				{
					"name": "获取任务 - 不存在的 ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('返回 404', function () {",
									"    pm.expect(pm.response.code).to.eql(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ai-api/v1/task/00000000-0000-0000-0000-000000000000",
							"host": ["{{base_url}}"],
							"path": ["ai-api", "v1", "task", "00000000-0000-0000-0000-000000000000"]
						},
						"description": "使用不存在的 task_id 查询，预期返回 404。"
					},
					"response": []
				},
				{
					"name": "批量获取任务",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.test('返回 tasks 数组', function () {",
									"        pm.expect(jsonData.tasks).to.be.an('array');",
									"    });",
									"    // 验证每个 task 都有必要字段",
									"    if (jsonData.tasks.length > 0) {",
									"        pm.test('每个 task 包含必要字段', function () {",
									"            jsonData.tasks.forEach(function (task) {",
									"                pm.expect(task.task_id).to.be.a('string');",
									"                pm.expect(task.task_type).to.be.oneOf([1, 2]);",
									"                pm.expect(task.status).to.be.oneOf([0, 1, 2, 3, 4, 5]);",
									"                pm.expect(task.model).to.be.a('string');",
									"            });",
									"        });",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"task_ids\": [\n    \"{{task_id}}\"\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai-api/v1/task/batch",
							"host": ["{{base_url}}"],
							"path": ["ai-api", "v1", "task", "batch"]
						},
						"description": "批量获取任务。使用集合变量 {{task_id}}。\n\n注意：\n- 最多支持 100 个 task_id\n- 不存在的 ID 会被忽略\n- 结果按请求顺序返回"
					},
					"response": []
				},
				{
					"name": "批量获取任务 - 多个 ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
